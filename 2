+#!/usr/bin/env bash
+set -euo pipefail
+
+TARGET="${1:-/home/haku/axole/crm_bot}"
+BUNDLE_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_SRC="$BUNDLE_DIR/repo"
+
+if ! git -C "$TARGET" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
+  echo "ERROR: target is not a git work tree: $TARGET" >&2
+  exit 1
+fi
+
+copy_tree() {
+  local src="$1"
+  local dst="$2"
+  while IFS= read -r -d '' file; do
+    local rel="${file#$src/}"
+    local out="$dst/$rel"
+    mkdir -p "$(dirname "$out")"
+    if [[ -e "$out" ]]; then
+      if cmp -s "$file" "$out"; then
+        continue
+      fi
+      if [[ "${FORCE:-0}" != "1" ]]; then
+        echo "ERROR: existing file differs: $out" >&2
+        echo "Set FORCE=1 only after reviewing the conflict." >&2
+        exit 1
+      fi
+    fi
+    cp "$file" "$out"
+  done < <(find "$src" -type f -print0)
+}
+
+append_marked_block() {
+  local target_file="$1"
+  local block_file="$2"
+  local marker="$3"
+  if grep -Fq "$marker" "$target_file"; then
+    echo "Already integrated: $marker"
+    return
+  fi
+  printf '\n\n' >> "$target_file"
+  cat "$block_file" >> "$target_file"
+}
+
+copy_tree "$REPO_SRC" "$TARGET"
+append_marked_block "$TARGET/AGENTS.md" "$BUNDLE_DIR/integration/AGENTS.addendum.md" "BEGIN CRM_BOT MVP WORK ITEM ROUTER"
+append_marked_block "$TARGET/.codex/workflows/implementation.md" "$BUNDLE_DIR/integration/implementation.addendum.md" "BEGIN MVP WORK ITEM OVERRIDE"
+
+chmod +x "$TARGET"/dev_scripts/*.sh 2>/dev/null || true
+
+echo "Installed Codex MVP work-item bundle into: $TARGET"
+echo "No commit or push was performed."
